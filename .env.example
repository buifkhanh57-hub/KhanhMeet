# ============================================================
# KHANHMEET — BIẾN MÔI TRƯỜNG CHO WEB (Next.js)
# ============================================================
# Sao chép thành .env rồi điền giá trị. Chỉ cần 1 biến:

# URL CÔNG KHAI của dịch vụ signaling (bắt buộc khi deploy lên Vercel).
# Khi ĐỂ TRỐNG: web chạy chế độ "local một máy" — tự nối signaling qua
# gateway ở cùng nguồn (dùng khi chạy `bun run dev` trên một máy chủ).
# Khi ĐẶT (vd deploy Vercel + signaling trên Railway):
NEXT_PUBLIC_SIGNALING_URL=https://khanhmeet-signaling.up.railway.app
